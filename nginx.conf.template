server {
    listen 80;

    # Archivos estáticos del frontend
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri /index.html;
    }

    # Proxy al backend
    location /api/ {
        proxy_pass http://backend-apis-ia:9086/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
